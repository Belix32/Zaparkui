{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/(.*)", "destination": "/" }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "zaparkyi.ru" }],
      "destination": "https://zaparkui.vercel.app/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.zaparkyi.ru" }],
      "destination": "https://zaparkui.vercel.app/$1",
      "permanent": true
    }
  ]
}